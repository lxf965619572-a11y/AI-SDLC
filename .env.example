# ===== LLM 默认配置（OpenAI 兼容协议）=====
# 外网公网模型示例：
#   LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
# 内网自部署模型示例（vLLM / Ollama 等 OpenAI 兼容端点，端口按实际改）：
#   LLM_BASE_URL=http://192.168.1.100:8000/v1  LLM_MODEL=qwen2.5-14b-instruct
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=300

# 离线演示模式：=1 时不调用真实 LLM，用内置模板生成各阶段产物（用于快速体验/测试）
LLM_MOCK=1

# ===== 按角色覆盖（可选；未配置则回退上面的默认值）=====
# 角色：extraction(抽取) / requirement(需求分析) / hld(概要设计) / lld(详细设计) / testcase(测试用例)
# LLM_EXTRACTION_BASE_URL=
# LLM_EXTRACTION_API_KEY=
# LLM_EXTRACTION_MODEL=
# LLM_REQUIREMENT_MODEL=
# LLM_HLD_MODEL=
# LLM_LLD_MODEL=
# LLM_TESTCASE_MODEL=

# ===== 联网检索（AI 助手「🌐 联网」开关，可选，默认关闭）=====
# 配置了 WEB_SEARCH_API_KEY 才会启用；不配置则前端不显示联网开关，系统完全离线可用。
# WEB_SEARCH_PROVIDER=bocha        # bocha(博查,默认) / tavily / bing
# WEB_SEARCH_API_KEY=sk-your-web-search-key
# WEB_SEARCH_MAX_RESULTS=5         # 每次注入上下文的搜索结果条数
# WEB_SEARCH_TIMEOUT=8             # 搜索超时秒数（超时/失败自动跳过，不影响对话）

# ===== Flask =====
APP_HOST=127.0.0.1
APP_PORT=5100
APP_DEBUG=1

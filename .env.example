# ===== LLM 默认配置（OpenAI 兼容协议）=====
# 外网公网模型示例：
#   LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
# 内网自部署模型示例（vLLM / Ollama 等 OpenAI 兼容端点，端口按实际改）：
#   LLM_BASE_URL=http://192.168.1.100:8000/v1  LLM_MODEL=qwen2.5-14b-instruct
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=300

# 离线演示模式：=1 时不调用真实 LLM，用内置模板生成各阶段产物（用于快速体验/测试）
LLM_MOCK=1

# LLM 调用是否跟随系统代理（HTTPS_PROXY 等环境变量）：默认 0 直连。
# 说明：LLM 端点（如国内阿里云/DeepSeek）通常直连可达；若跟随系统代理，
# 代理软件（梯子/Clash 等）关闭时会报 WinError 10061 连接被拒绝。
# 仅当你的 LLM 必须经代理访问（如海外 OpenAI）时才设为 1。
LLM_TRUST_PROXY=0

# ===== 按角色覆盖（可选；未配置则回退上面的默认值）=====
# 角色：extraction(抽取) / requirement(需求分析) / hld(概要设计) / lld(详细设计) / testcase(测试用例)
# LLM_EXTRACTION_BASE_URL=
# LLM_EXTRACTION_API_KEY=
# LLM_EXTRACTION_MODEL=
# LLM_REQUIREMENT_MODEL=
# LLM_HLD_MODEL=
# LLM_LLD_MODEL=
# LLM_TESTCASE_MODEL=

# ===== 联网检索（AI 助手「🌐 联网」开关，可选，默认关闭）=====
# 配置了 WEB_SEARCH_API_KEY 才会启用；不配置则前端不显示联网开关，系统完全离线可用。
# WEB_SEARCH_PROVIDER=bocha        # bocha(博查,默认) / tavily / bing
# WEB_SEARCH_API_KEY=sk-your-web-search-key
# WEB_SEARCH_MAX_RESULTS=5         # 每次注入上下文的搜索结果条数
# WEB_SEARCH_TIMEOUT=8             # 搜索超时秒数（超时/失败自动跳过，不影响对话）

# ===== Flask =====
APP_HOST=127.0.0.1
APP_PORT=5100
APP_DEBUG=1

# ===== 代码验证执行环境（远端 Linux 机器，可选）=====
# 编译 / 运行 / 覆盖率都不在本机跑：需要可信的 gcc + gcov，且后续要换 QEMU 目标机模拟。
# 一次性配置免密：Windows PowerShell 跑 scripts\setup_verify_vm.ps1
#   （密码只在装公钥那一步用，不要写进本文件）
# 不配置也能跑：流水线退化为「只静态检查、不实际执行」，执行结论标 skipped，不会假绿。
# VERIFY_HOST=192.168.x.x
# VERIFY_USER=your_linux_user
# VERIFY_PORT=22
# 私钥路径；留空则用 ~/.ssh/id_ed25519_workbuddy_verify（setup 脚本的默认位置）
# VERIFY_KEY=
# 主机密钥钉扎文件；留空用系统默认 known_hosts
# VERIFY_KNOWN_HOSTS=
# 远端工作区根目录（相对 $HOME），实际路径为 ~/<VERIFY_WORKDIR>/p<项目>/v<版本>/
# VERIFY_WORKDIR=wb_verify
# VERIFY_TIMEOUT=300
# =1 时忽略 VERIFY_HOST，改用本机工具链（Linux/macOS 开发机自测用）
# VERIFY_LOCAL=0

# ===== 目标机矩阵（可选，默认只测验证机本机）=====
# 同一份源码在哪些目标架构上分别交叉编译 + qemu 执行 + 采覆盖率，逗号分隔。
# 可选：host（验证机本机 x86-64）/ arm32（ARM 32 位小端）/
#       arm64（ARM 64 位小端）/ ppc32（PowerPC 32 位大端）
# 为什么要多目标：宿主机跑绿只证明「在这台机器的 gcc 与 ABI 下行为正确」，
# 而字长、字节序、对齐、32 位截断这类缺陷只有换目标机才暴露得出来。
# 汇总结论取各目标最差值：任一目标不通过即整体不通过；工具链缺失的目标记
# 「未验证」并整轮转人工裁决，不会被静默放行。
# 验证机装交叉工具链（幂等）：bash scripts/setup_verify_targets.sh
# VERIFY_TARGETS=host
# VERIFY_TARGETS=host,arm32,ppc32

# ===== 验证判据 =====
# 分支覆盖率门限：低于该值的需求行在追溯矩阵里标红。0 表示不判覆盖率。
# COVERAGE_BRANCH_MIN=80
# COVERAGE_LINE_MIN=0
# 圈复杂度上限（静态规则 WB-C-006）
# COMPLEXITY_MAX=10
# 执行失败 / 必查项违规的最大自动整改轮数，超出即出问题报告单转人工裁决
# MAX_FIX_ROUNDS=2
